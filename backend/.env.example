APP_NAME=CityCare
APP_ENV=development
API_V1_PREFIX=/api/v1
# SQLite for local Phase 2. Switch to PostgreSQL later:
# DATABASE_URL=postgresql+psycopg://citycare:citycare@localhost:5432/citycare
DATABASE_URL=sqlite:///./citycare.db
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:3000
ACCESS_TOKEN_EXPIRE_MINUTES=1440
JWT_ALGORITHM=HS256
