<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ : l’API Splash Screen ignore windowBackground.
     On force le violet de marque pour que le flash USB ne soit plus bleu. -->
<resources>
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowSplashScreenBackground">@color/citycare_splash_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/citycare_splash_logo</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/citycare_splash_background</item>
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">?android:colorBackground</item>
    </style>
</resources>
