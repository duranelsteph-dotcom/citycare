# Copier vers deploy/.env sur le VPS (ne jamais committer .env)
# cp deploy/.env.example deploy/.env

# Domaine pointant (DNS A) vers l'IP publique du VPS
DOMAIN=api.votredomaine.com

# Postgres
POSTGRES_DB=citycare
POSTGRES_USER=citycare
POSTGRES_PASSWORD=CHANGEZ_MOI_mot_de_passe_fort

# JWT — générer : openssl rand -hex 32
SECRET_KEY=CHANGEZ_MOI_au_moins_32_caracteres_aleatoires

# CORS navigateur. L'APK mobile n'est pas soumis au CORS.
# "*" autorisé (sans cookies navigateur). Ou liste d'origines séparées par des virgules.
CORS_ORIGINS=*

ACCESS_TOKEN_EXPIRE_MINUTES=1440
